APP_NAME=SmartHive API
ENVIRONMENT=development

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Autenticacao: "dev" (sem login, usuario fixo dev-local) ou "cognito".
# Em ENVIRONMENT=production a API so sobe com AUTH_MODE=cognito.
AUTH_MODE=dev
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Banco: vazio usa JSON local; preenchido usa PostgreSQL (Amazon RDS).
# Ex.: postgresql://smarthive:SENHA@HOST:5432/smarthive
DATABASE_URL=
DATABASE_SSLMODE=require

# Storage: "local" (pasta app/uploads) ou "s3" (bucket privado).
# No EC2 as credenciais vem da IAM Role da instancia; nao coloque chaves AWS aqui.
STORAGE_BACKEND=local
S3_BUCKET=
MAX_UPLOAD_MB=50
