# Portas publicadas no host
FRONTEND_PORT=5173
BACKEND_PORT=8000

# O frontend em Docker usa Nginx para proxyar /api e /uploads para o backend.
VITE_API_URL=/api

# Backend
APP_NAME=SmartHive API
ENVIRONMENT=docker
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# Autenticacao: "dev" para testar sem Cognito, "cognito" para validar tokens reais.
AUTH_MODE=dev
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Postgres local (simula o Amazon RDS). O schema e o seed rodam na primeira subida.
POSTGRES_PASSWORD=smarthive-local

# Storage: "local" ou "s3". Para testar S3 localmente sera preciso credenciais AWS no host.
STORAGE_BACKEND=local
S3_BUCKET=
MAX_UPLOAD_MB=50
