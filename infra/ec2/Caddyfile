{
	admin off
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

{$ORIGIN_DOMAIN} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	@semSegredo not header X-Origin-Verify {$ORIGIN_SECRET}
	respond @semSegredo "Forbidden" 403

	@multipart header Content-Type multipart/form-data*
	request_body @multipart {
		max_size 55MB
	}
	@semMultipart not header Content-Type multipart/form-data*
	request_body @semMultipart {
		max_size 1MB
	}

	header -Server
	reverse_proxy backend:8000
}

import /etc/caddy/sites.caddy
