# Portas publicadas no host
FRONTEND_PORT=5173
BACKEND_PORT=8000

# O frontend em Docker usa Nginx para proxyar /api e /uploads para o backend.
VITE_API_URL=/api
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY

# Backend
APP_NAME=SmartHive API
APP_VERSION=0.1.0
ENVIRONMENT=docker
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# Por padrao, o MVP usa JSON local persistido em volume Docker.
USE_SUPABASE=false

# Preencha somente quando for usar Supabase/PostgreSQL externo.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=smarthive-capturas
DATABASE_URL=
